CONTENT BEGIN
  0  : 10100001; -- d
  1  : 10000110; -- E
  2  : 11000000; -- 0
  3  : 01111111; -- .
  4  : 11111111; -- SP
  5  : 10100001; -- d
  6  : 10000110; -- E
  7  : 11111001; -- 1
  8  : 01111111; -- .
  9  : 11111111; -- SP
  A  : 10100001; -- d
  B  : 10000110; -- E
  C  : 11111001; -- 1
  D  : 11000000; -- 0
  E  : 01111111; -- .
  F  : 11111111; -- SP
END;
